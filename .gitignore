# Node
node_modules/
debug-ui/dist/
debug-ui/src/wasm/
# Generated by scripts/gen-fixture-manifest.mjs (predev/prebuild hooks) —
# always regenerated from fixtures/ on disk, never authored by hand.
debug-ui/public/fixtures-manifest.json

# Rust
target/

# Android build artifacts
**/android/.cxx/
**/android/build/
**/android/.gradle/

# iOS build artifacts
**/ios/build/
**/ios/Pods/

# Python
__pycache__/
.venv/
.pytest_cache/
.mypy_cache/
bindings/python/dist/

# Misc
.DS_Store
*.log

# Real-photo captures under fixtures/real/
# - PNGs are committed regression anchors (keep tracked).
# - luma/json are regenerable from PNG (see tools/fixtures/README.md).
# - Source videos / domain packs stay local only.
fixtures/real/*.luma
fixtures/real/*.json
fixtures/real/**/*.mp4
fixtures/real/**/*.mov
fixtures/real/**/*.webm
fixtures/real/domain-data-mp4/
# GPU gold-standard multi-scan domain packs (large; local eval only).
fixtures/real/full-domain-data/
.claude/worktrees/
